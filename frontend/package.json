{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "build:test": "ng build --configuration test",
    "start:test": "ng serve --configuration test",
    "build:uat": "ng build --configuration uat",
    "start:uat": "ng serve --configuration uat",
    "build:preprod": "ng build --configuration preprod",
    "start:preprod": "ng serve --configuration preprod",
    "build:prod": "ng build --configuration prod",
    "start:prod": "ng serve --configuration prod",
    "ssr:test": "ng build --configuration test && node dist/frontend/server/server.mjs",
    "ssr:uat": "ng build --configuration uat && node dist/frontend/server/server.mjs",
    "ssr:preprod": "ng build --configuration preprod && node dist/frontend/server/server.mjs",
    "ssr:prod": "ng build --configuration prod && node dist/frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.20",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
